{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/cadastro", "destination": "/cadastro/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
